DATABASE_URL="file:./dev.db"
PORT=4000
# Strong, randomly generated secret used to sign session JWTs / cookies.
# Generate your own for every deployment, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real production secret to source control. 
JWT_SECRET="e7bc8e25a9073f1e924b723fef7f50f0cc91c05c136bb13ddf1a8b6ea8c59973dbaba32375359403d88b541ba4a9b2ee"
UPLOAD_MAX_SIZE_MB=25
CLIENT_ORIGIN=https://harshsawant-64.github.io
# Set to "true" only when the app is served over HTTPS (production). Keeping 
# this false on plain-HTTP LAN/dev deployments is required or the browser
# will silently refuse to send the auth cookie.
COOKIE_SECURE=false
NODE_ENV=development
